#!/usr/bin/env bash
# Pre-commit hook: 보안 패턴 grep + lint
# Activate: git config core.hooksPath .githooks

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "→ pre-commit: scanning for forbidden patterns..."

PATTERN='62\.171\.141\.206|valuealpha@10\.0\.0\.2|lch6817556|C:[\\/]Users[\\/]lch68|[0-9]{8,12}:AA[A-Za-z0-9_-]{30,}|BEGIN .* PRIVATE KEY'

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '(node_modules|\.next|out|package-lock\.json|\.githooks/)' || true)

if [ -z "$STAGED" ]; then
  echo "  no staged files to scan."
else
  HITS=$(echo "$STAGED" | xargs -I{} grep -lE "$PATTERN" {} 2>/dev/null || true)
  if [ -n "$HITS" ]; then
    echo -e "${RED}✗ FORBIDDEN PATTERN DETECTED:${NC}"
    echo "$HITS"
    echo
    echo "  허용 안 되는 패턴 (VPS IP / 실명 / 이메일 / 토큰 / private key) 감지."
    echo "  환경변수 또는 placeholder 로 교체 후 재시도."
    exit 1
  fi
fi

echo -e "${GREEN}✓ no forbidden patterns${NC}"
echo "→ pre-commit: done"
